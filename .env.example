# انسخ هذا الملف إلى .env وعدّل القيم
# Copy this file to .env and adjust the values

# المنفذ الذي يعمل عليه السيرفر
PORT=3000

# اسم الموقع (يظهر في العناوين والصفحات)
SITE_NAME=فضفضة عشوائية

# رابط الموقع النهائي (يُستخدم في canonical و sitemap وروابط المشاركة)
# بدّل example.com برابط موقعك الحقيقي بعد النشر
SITE_URL=https://example.com

# سر الجلسات — ضع قيمة عشوائية طويلة وفريدة في الإنتاج!
# مثال لتوليد واحد: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ضع-هنا-سرًا-عشوائيًا-طويلًا-جدًا

# اجعلها 1 عند التشغيل خلف HTTPS (معظم منصات النشر)
COOKIE_SECURE=0
